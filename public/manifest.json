{
  "manifest_version": 3,
  "name": "Tab Recorder + Local Transcriber",
  "version": "0.0.1",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
